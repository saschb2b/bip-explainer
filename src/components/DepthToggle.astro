---
export interface Props {
  content: string;
}

const { content } = Astro.props;

function parseBody(text: string) {
  const lines = text.replace(/\r\n/g, '\n').split('\n');
  const out: string[] = [];
  let inList = false;

  for (const raw of lines) {
    const line = raw.trimEnd();
    if (line.trim() === '') continue;

    if (line.trim().startsWith('- ')) {
      if (!inList) {
        out.push('<ul class="list-disc pl-5 space-y-1 mt-3">');
        inList = true;
      }
      const item = line.trim().replace(/^- /, '').replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
      out.push(`<li class="text-gray-800">${item}</li>`);
      continue;
    }

    if (inList) {
      out.push('</ul>');
      inList = false;
    }

    if (line.startsWith('## ')) {
      out.push(`<h3 class="font-semibold text-gray-900 mt-6 mb-2">${line.replace(/^## /, '')}</h3>`);
      continue;
    }

    const para = line.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
    out.push(`<p class="text-gray-800 leading-relaxed">${para}</p>`);
  }

  if (inList) out.push('</ul>');
  return out.join('\n');
}

const sections = content.trim().split(/## Level: /).filter((b) => b.trim()).map((block) => {
  const [rawTitle, ...bodyLines] = block.trim().split('\n');
  const title = rawTitle.trim();
  const body = parseBody(bodyLines.join('\n'));
  return { title, body };
});

const labels = ["Plain English", "Informed User", "Developer", "Spec"];
---

<section class="py-12 sm:py-16 bg-white" id="explainer">
  <div class="max-w-3xl mx-auto px-6">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-semibold text-gray-900">Explainer</h2>
      <span class="text-sm text-gray-400">Choose depth</span>
    </div>
    <div role="tablist" aria-label="Depth levels" class="flex flex-wrap gap-2 mb-8">
      {labels.map((label, i) => (
        <button
          role="tab"
          aria-selected={i === 0 ? "true" : "false"}
          aria-controls={`depth-panel-${i}`}
          id={`depth-tab-${i}`}
          data-depth-tab
          data-index={i}
          class={`px-4 py-2 rounded-md text-sm font-medium border transition-colors ${
            i === 0
              ? "bg-gray-900 text-white border-gray-900"
              : "bg-white text-gray-600 border-gray-200 hover:border-gray-300 hover:text-gray-800"
          }`}
        >
          {label}
        </button>
      ))}
    </div>

    <div class="prose-custom">
      {sections.map((section, i) => (
        <div
          id={`depth-panel-${i}`}
          role="tabpanel"
          aria-labelledby={`depth-tab-${i}`}
          data-tab-panel
          class={i === 0 ? "active" : ""}
        >
          {section.title === "Spec" ? (
            <div class="space-y-3">
              {section.body.split('\n').filter(line => line.includes('<li')).map(line => {
                const text = line.replace(/<li class="text-gray-800">/, '').replace('</li>', '');
                const match = text.match(/^(.+?):\s*(https?:\/\/.+)$/);
                if (match) {
                  return (
                    <p class="text-sm text-gray-700">
                      <span class="font-medium text-gray-800">{match[1]}:</span>{" "}
                      <a href={match[2]} target="_blank" rel="noopener noreferrer" class="text-accent-700 hover:text-accent-900 underline">{match[2]}</a>
                    </p>
                  );
                }
                return <p class="text-sm text-gray-700">{text}</p>;
              })}
            </div>
          ) : (
            <div set:html={section.body} />
          )}
        </div>
      ))}
    </div>
  </div>
</section>
