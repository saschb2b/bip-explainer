---
export interface Props {
  disagreements: {
    title: string;
    summary: string;
    type: "definitional" | "factual" | "values" | "technical-judgment";
    typeDescription?: string;
    link: string;
  }[];
}

const { disagreements } = Astro.props;

const typeMeta: Record<
  string,
  { label: string; hint: string; axis: "resolvable" | "unresolvable" }
> = {
  definitional: {
    label: "Definitional",
    hint: "Same word, different meaning",
    axis: "resolvable",
  },
  factual: {
    label: "Factual",
    hint: "Evidence could settle it",
    axis: "resolvable",
  },
  values: {
    label: "Values",
    hint: "No single correct answer",
    axis: "unresolvable",
  },
  "technical-judgment": {
    label: "Technical judgment",
    hint: "Experts weigh trade-offs differently",
    axis: "unresolvable",
  },
};

const order = ["definitional", "factual", "values", "technical-judgment"];
const sorted = [...disagreements].sort(
  (a, b) => order.indexOf(a.type) - order.indexOf(b.type),
);
---

<section class="bip-section">
  <div class="sec-eyebrow">05 — Where it's contested</div>
  <h2 class="sec-title">Four live disagreements, mapped by type.</h2>
  <p class="sec-lede">
    Not all arguments are the same argument. The top row could in principle be resolved with
    evidence or shared definitions. The bottom row is genuinely unresolvable — reasonable people can
    disagree.
  </p>

  <div class="dm-matrix">
    <div class="dm-matrix-axis dm-matrix-axis--y" aria-hidden="true">
      <span class="dm-axis-top">Resolvable</span>
      <span class="dm-axis-bot">Irreducible</span>
    </div>
    <div>
      <div class="dm-axis-mobile">Resolvable</div>
      <div class="dm-grid">
        {sorted.map((d, i) => {
          const m = typeMeta[d.type];
          const isFirstUnresolvable = m.axis === "unresolvable" && (i === 0 || typeMeta[sorted[i - 1].type].axis !== "unresolvable");
          return (
            <>
              {isFirstUnresolvable && <div class="dm-axis-mobile dm-axis-mobile--inline">Irreducible</div>}
              <div class={`dm-cell dm-cell--${m.axis} dm-cell--${d.type}`}>
                <span class={`dm-tag dm-tag--${d.type}`}>
                  <span class="dm-tag-dot"></span>
                  {m.label}
                </span>
                <div class="dm-cell-title">{d.title}</div>
                <div class="dm-cell-body">{d.summary}</div>
                <div class="dm-cell-foot">
                  <span class="dm-cell-hint">{m.hint}</span>
                  <a class="dm-cell-link" href={d.link} target="_blank" rel="noopener noreferrer">
                    primary source →
                  </a>
                </div>
              </div>
            </>
          );
        })}
      </div>
    </div>
  </div>
</section>
