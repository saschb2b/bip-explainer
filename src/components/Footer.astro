---
export interface Props {
  lastUpdated: string;
}

const { lastUpdated } = Astro.props;

const updatedLabel = new Date(lastUpdated).toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
});
---

<footer class="ft">
  <div class="ft-grid">
    <div>
      <div class="ft-brand">
        <span class="ft-brand-mark">◇</span>
        <span class="ft-brand-name">BIP Explainer</span>
      </div>
      <p class="ft-mission">
        A layered explainer for protocol proposals. Built to help non-developers form a defensible view in 15 minutes.
      </p>
    </div>
    <div>
      <div class="ft-col-hd">Editorial policy</div>
      <ul class="ft-list">
        <li>Every disagreement is tagged by type.</li>
        <li>Every voice links to a primary source.</li>
        <li>The page never tells you what to do.</li>
      </ul>
    </div>
    <div>
      <div class="ft-col-hd">This page</div>
      <ul class="ft-list">
        <li>Last updated · {updatedLabel}</li>
        <li>
          <a href="https://github.com/saschb2b/bip-explainer" target="_blank" rel="noopener noreferrer">
            Contribute on GitHub →
          </a>
        </li>
        <li>
          <a href="#top" data-back-to-top>Back to top ↑</a>
        </li>
      </ul>
    </div>
  </div>
</footer>
