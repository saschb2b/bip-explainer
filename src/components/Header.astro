---
export interface Props {
  breadcrumb: { label: string; href?: string }[];
  proposalId: string;
  category: string;
  title: string;
  subtitle: string;
  status: string;
  affects: string;
  lastUpdated: string;
}

const { breadcrumb, proposalId, category, title, subtitle, status, affects, lastUpdated } = Astro.props;

const updatedLabel = new Date(lastUpdated).toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
});
---

<header class="hdr">
  <nav class="hdr-crumb" aria-label="Breadcrumb">
    {breadcrumb.map((c, i) => (
      <>
        {i > 0 && <span class="hdr-crumb-sep">/</span>}
        <span class={i === breadcrumb.length - 1 ? "hdr-crumb-cur" : ""}>{c.label}</span>
      </>
    ))}
  </nav>

  <div class="hdr-meta-row">
    <span class="hdr-id">{proposalId.toUpperCase()}</span>
    <span class="hdr-dot">·</span>
    <span class="hdr-category">{category}</span>
    <span class="hdr-dot">·</span>
    <span class="hdr-updated">Updated {updatedLabel}</span>
  </div>

  <h1 class="hdr-title">{title}</h1>
  <p class="hdr-subtitle">{subtitle}</p>

  <div class="hdr-status">
    <div class="hdr-status-item">
      <span class="hdr-status-dot hdr-status-dot--contested"></span>
      <span class="hdr-status-label">{status}</span>
    </div>
    <div class="hdr-status-item">
      <span class="hdr-status-affects">Affects</span>
      <span class="hdr-status-value">{affects}</span>
    </div>
  </div>
</header>
