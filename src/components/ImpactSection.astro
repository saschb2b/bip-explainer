---
export interface Props {
  impacts: {
    combinations: {
      walletVintage: string;
      addressType: string;
      severity: string;
      title: string;
      text: string;
    }[];
  };
}

const { impacts } = Astro.props;

const severityStyles: Record<string, { box: string; badge: string }> = {
  high: {
    box: "bg-red-50 border-red-200",
    badge: "bg-red-100 text-red-700",
  },
  medium: {
    box: "bg-amber-50 border-amber-200",
    badge: "bg-amber-100 text-amber-700",
  },
  low: {
    box: "bg-blue-50 border-blue-200",
    badge: "bg-blue-100 text-blue-700",
  },
  info: {
    box: "bg-slate-50 border-slate-200",
    badge: "bg-slate-100 text-slate-700",
  },
};

const walletOptions = [
  { value: "", label: "Select wallet vintage" },
  { value: "pre-2013", label: "Pre-2013" },
  { value: "2013-2021", label: "2013 – 2021" },
  { value: "2021-plus", label: "2021 or later" },
  { value: "unsure", label: "Not sure" },
];

const addressOptions = [
  { value: "", label: "Select address type" },
  { value: "p2pk", label: "P2PK (very old mining addresses)" },
  { value: "p2pkh", label: "Legacy (starts with 1...)" },
  { value: "segwit", label: "SegWit (starts with bc1q...)" },
  { value: "taproot", label: "Taproot (starts with bc1p...)" },
  { value: "unsure", label: "Not sure" },
];
---

<section class="py-12 sm:py-16 bg-white" id="impact">
  <div class="max-w-3xl mx-auto px-6">
    <h2 class="text-xl font-semibold text-gray-900 mb-2">What this means for you</h2>
    <p class="text-gray-600 mb-6">No wallet connection needed. Select your setup to see how the proposals affect your coins.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div>
        <label for="wallet-vintage" class="block text-sm font-medium text-gray-700 mb-1.5">Wallet vintage</label>
        <select id="wallet-vintage" class="w-full rounded-md border-gray-300 bg-white py-2.5 px-3 text-sm text-gray-900 shadow-sm focus:border-accent-600 focus:ring-accent-600 border">
          {walletOptions.map(opt => <option value={opt.value}>{opt.label}</option>)}
        </select>
      </div>
      <div>
        <label for="address-type" class="block text-sm font-medium text-gray-700 mb-1.5">Address type</label>
        <select id="address-type" class="w-full rounded-md border-gray-300 bg-white py-2.5 px-3 text-sm text-gray-900 shadow-sm focus:border-accent-600 focus:ring-accent-600 border">
          {addressOptions.map(opt => <option value={opt.value}>{opt.label}</option>)}
        </select>
      </div>
    </div>

    <div id="impact-results" class="space-y-4">
      {impacts.combinations.map((combo, i) => {
        const styles = severityStyles[combo.severity] || severityStyles.info;
        return (
          <div
            data-impact-result
            data-wallet={combo.walletVintage}
            data-address={combo.addressType}
            class={`rounded-lg border p-5 ${styles.box}`}
          >
            <div class="flex items-center gap-2 mb-2">
              <span class={`inline-flex items-center px-2 py-0.5 rounded text-xs font-medium ${styles.badge}`}>
                {combo.severity === "high" ? "High risk" : combo.severity === "medium" ? "Medium risk" : combo.severity === "low" ? "Low risk" : "Guide"}
              </span>
            </div>
            <h3 class="font-semibold text-gray-900 mb-1">{combo.title}</h3>
            <p class="text-sm text-gray-700 leading-relaxed">{combo.text}</p>
          </div>
        );
      })}
      <div data-impact-result data-fallback class="rounded-lg border border-gray-200 bg-gray-50 p-5 text-sm text-gray-600">
        Select both options above to see your personalized impact summary.
      </div>
    </div>
  </div>
</section>
