---
export interface Props {
  signals: {
    coreImplementation: string;
    nodeSignaling: string;
    predictionMarket: string;
    historicalAnalog: string;
  };
  lastUpdated: string;
}

const { signals, lastUpdated } = Astro.props;

const items = [
  { label: "Core implementation", value: signals.coreImplementation },
  { label: "Node signaling", value: signals.nodeSignaling },
  { label: "Prediction markets", value: signals.predictionMarket },
  { label: "Historical analog", value: signals.historicalAnalog },
];
---

<section class="py-12 sm:py-16 bg-gray-50" id="signals">
  <div class="max-w-3xl mx-auto px-6">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-semibold text-gray-900">Live signals</h2>
      <span class="text-xs text-gray-400">Hand-curated • Updated {lastUpdated}</span>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {items.map((item) => (
        <div class="bg-white rounded-lg border border-gray-100 p-5 shadow-sm">
          <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">{item.label}</p>
          <p class="text-lg font-semibold text-gray-900">{item.value}</p>
        </div>
      ))}
    </div>
    <p class="mt-4 text-xs text-gray-400">These values are updated manually when something material changes. No real-time feeds.</p>
  </div>
</section>
