---
export interface Props {
  voices: {
    name: string;
    role: string;
    roleType: string;
    position: string;
    sourceUrl: string;
  }[];
}

const { voices } = Astro.props;

const roleStyles: Record<string, string> = {
  author: "bg-accent-50 text-accent-700 border-accent-100",
  critic: "bg-red-50 text-red-700 border-red-100",
  alternative: "bg-blue-50 text-blue-700 border-blue-100",
};

function initials(name: string) {
  return name.split(" ").map(p => p[0]).join("").slice(0, 2).toUpperCase();
}
---

<section class="py-12 sm:py-16 bg-white" id="voices">
  <div class="max-w-3xl mx-auto px-6">
    <h2 class="text-xl font-semibold text-gray-900 mb-6">Voices</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {voices.map((voice) => (
        <a href={voice.sourceUrl} target="_blank" rel="noopener noreferrer" class="group block bg-white rounded-lg border border-gray-100 p-5 shadow-sm hover:shadow transition-shadow">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-full bg-gray-900 text-white flex items-center justify-center text-sm font-bold">
              {initials(voice.name)}
            </div>
            <div class="min-w-0">
              <p class="text-sm font-semibold text-gray-900 truncate">{voice.name}</p>
              <span class={`inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium border ${roleStyles[voice.roleType] || roleStyles.alternative}`}>
                {voice.role}
              </span>
            </div>
          </div>
          <p class="text-sm text-gray-600 leading-relaxed line-clamp-4">{voice.position}</p>
          <span class="mt-3 inline-block text-xs text-gray-400 group-hover:text-accent-700 transition-colors">Read primary source →</span>
        </a>
      ))}
    </div>
  </div>
</section>
