---
export interface Props {
  voices: {
    name: string;
    role: string;
    roleType: "author" | "critic" | "alternative";
    position: string;
    sourceUrl: string;
  }[];
}

const { voices } = Astro.props;

type Stance = { x: number; y: number; stance: "for" | "against" | "alternative" };

const stances: Record<string, Stance> = {
  "Jameson Lopp": { x: 78, y: 55, stance: "for" },
  "Charles Hoskinson": { x: 12, y: 55, stance: "against" },
  "Eli Ben-Sasson / StarkWare": { x: 35, y: 18, stance: "alternative" },
  "BitMEX Research": { x: 58, y: 18, stance: "alternative" },
};

function initials(name: string): string {
  return name
    .split(/[\s\/]+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((s) => s[0])
    .join("")
    .toUpperCase();
}
---

<section class="bip-section vs">
  <div class="sec-eyebrow">06 — Who's saying what</div>
  <h2 class="sec-title">Positioned, not ranked.</h2>
  <p class="sec-lede">
    Author and critic sit on a For ↔ Against axis. Alternative proposals sit above it — they don't
    oppose, they reroute.
  </p>

  <div class="vs-plot">
    <div class="vs-plot-frame">
      <span class="vs-plot-label vs-plot-label--top">Alternative proposals</span>
      <span class="vs-plot-label vs-plot-label--left">Against</span>
      <span class="vs-plot-label vs-plot-label--right">For</span>
      <div class="vs-plot-axis-h"></div>
      <div class="vs-plot-axis-v"></div>

      {voices.map((v, i) => {
        const s = stances[v.name];
        if (!s) return null;
        return (
          <button
            type="button"
            class={`vs-node vs-node--${s.stance}`}
            data-voice={i}
            style={`left: ${s.x}%; top: ${s.y}%;`}
            aria-label={`${v.name} — ${v.role}`}
          >
            <span class="vs-node-avatar">{initials(v.name)}</span>
            <span class="vs-node-label">{v.name}</span>
          </button>
        );
      })}
    </div>
  </div>

  <div class="vs-cards">
    {voices.map((v, i) => (
      <div class="vs-card" data-voice={i}>
        <div class="vs-card-hd">
          <span class="vs-card-avatar">{initials(v.name)}</span>
          <div class="vs-card-titles">
            <div class="vs-card-name">{v.name}</div>
            <div class="vs-card-role">{v.role}</div>
          </div>
          <span class={`vs-card-tag vs-card-tag--${v.roleType}`}>{v.roleType}</span>
        </div>
        <div class="vs-card-pos">{v.position}</div>
        <a class="vs-card-src" href={v.sourceUrl} target="_blank" rel="noopener noreferrer">
          Primary source →
        </a>
      </div>
    ))}
  </div>
</section>
