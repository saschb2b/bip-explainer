---
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import yaml from "js-yaml";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import PersonalImpact from "../components/PersonalImpact.astro";
import DepthReader from "../components/DepthReader.astro";
import Timeline from "../components/Timeline.astro";
import Readiness from "../components/Readiness.astro";
import DisagreementMap from "../components/DisagreementMap.astro";
import Voices from "../components/Voices.astro";
import Footer from "../components/Footer.astro";

const base = resolve(process.cwd(), "content/proposals/bitcoin-bip-360-361");

function readJson(path: string) {
  return JSON.parse(readFileSync(path, "utf-8"));
}

function readMd(path: string) {
  const raw = readFileSync(path, "utf-8");
  const frontmatterMatch = raw.match(
    /^---\r?\n([\s\S]*?)\r?\n---\r?\n([\s\S]*)$/,
  );
  if (!frontmatterMatch) return { frontmatter: {}, body: raw };
  const frontmatter = yaml.load(frontmatterMatch[1]) as Record<string, any>;
  const body = frontmatterMatch[2];
  return { frontmatter, body };
}

const md = readMd(resolve(base, "index.md"));
const disagreements = readJson(resolve(base, "disagreements.json"));
const voices = readJson(resolve(base, "voices.json"));
const impacts = readJson(resolve(base, "impacts.json"));

const fm = md.frontmatter;
---

<Layout title={`${fm.title} — BIP Explainer`} description={fm.subtitle}>
  <div id="top" class="page page-wide">
    <Header
      breadcrumb={fm.breadcrumb}
      proposalId={fm.proposalId}
      category={fm.category}
      title={fm.title}
      subtitle={fm.subtitle}
      status={fm.status}
      affects={fm.affects}
      lastUpdated={fm.lastUpdated}
    />

    <main>
      <PersonalImpact impacts={impacts} />
      <DepthReader content={md.body} />
      <Timeline />
      <Readiness signals={fm.signals} />
      <DisagreementMap disagreements={disagreements} />
      <Voices voices={voices} />
    </main>

    <Footer lastUpdated={fm.lastUpdated} />
  </div>
</Layout>
